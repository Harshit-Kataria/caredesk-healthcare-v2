{
  "name": "caredesk-capstone",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack healthcare appointment administration capstone",
  "type": "commonjs",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"node --watch server.js\" \"node node_modules/vite/bin/vite.js\"",
    "start": "node server.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "seed": "node seed.js",
    "test": "node --test",
    "test:ai": "node --test test/ai.test.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^9.10.4",
    "node-cron": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "redis": "^5.8.3",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.16.2",
    "vite": "^7.1.7"
  }
}
